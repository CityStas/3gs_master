{
  "$comment": [
    "What to download, where from, and how to prove it arrived intact.",
    "",
    "The weights are ~36 GB and are NOT in git, so a fresh clone has code and nothing",
    "else. This file is the missing half: `gs models fetch` reads it, resolves the",
    "target through model_paths.py (GS_MODELS_ROOT, no drive letters anywhere) and",
    "downloads only what is absent. `gs models verify` re-hashes and fails loudly.",
    "",
    "`size` and `sha256` are the HuggingFace LFS values, not guesses - they were read",
    "from the API for these exact repos, and every one of them matches the file the",
    "project was developed against, byte for byte. `path` is relative to the models",
    "root (GS_MODELS_ROOT), except group `3d`/`3d-x`, which is relative to",
    "<comfy root>/ComfyUI/models."
  ],
  "version": 1,
  "groups": {
    "llm": {
      "title": "Chat model for pi (llama.cpp router :8080)",
      "required": true,
      "default": true
    },
    "rag": {
      "title": "Embedder + reranker (the RAG needs both)",
      "required": true,
      "default": true
    },
    "vlm": {
      "title": "Qwen2.5-VL-7B - look at a screenshot, describe an image (:8082)",
      "required": false,
      "default": true
    },
    "image": {
      "title": "z-image-turbo - text to image (sd-server :8687)",
      "required": false,
      "default": true
    },
    "3d": {
      "title": "ComfyUI 3D - Pixal3D (default), MoGe, TripoSplat, BiRefNet",
      "required": false,
      "default": true
    },
    "3d-x": {
      "title": "Trellis2 backbone (optional, +6.5 GB; switch=True in the workflow)",
      "required": false,
      "default": false
    }
  },
