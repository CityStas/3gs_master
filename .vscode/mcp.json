{
  "servers": {
    "threejs-rag": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "threejs.mcp.rag_mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    "godot-rag": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "gdmaster.mcp.rag_mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/godot"
      }
    },
    "unity-rag": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "unimaster.mcp.rag_mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/unity"
      }
    },
    "rbx-rag": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "rbxmaster.mcp.rag_mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/roblox"
      }
    },
    "rbx-project": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "rbxmaster.mcp.project_mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}/roblox"
      }
    },
    "roblox-studio": {
      "type": "stdio",
      "command": "cmd.exe",
      "args": [
        "/c",
        "%LOCALAPPDATA%\\Roblox\\mcp.bat"
      ]
    },
    "assets": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "threejs.mcp.assets_mcp_server"
      ],
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  }
}
