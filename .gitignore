# В репозитории только код и корпус знаний.
# Модели, бинарники движков, пользовательские проекты и логи не версионируются:
# это десятки гигабайт, которые качаются скриптами по README.

# --- модели и бинарники ------------------------------------------------
models/
bin/
Dust3D-win32-x86_64/
Mesh2Motion/
godot/bin/
godot/models/
.venv/
venv/
__pycache__/
*.pyc

# --- данные и индексы (воспроизводятся из корпуса) ---------------------
data/sqlite/
data/gen-staging/
data/gen-status.json
data/gen.lock
godot/data/
unity/data/
unity/knowledge/
# roblox/data - то, что качает `gs roblox-fetch` (~3600 страниц) и из чего
# собирается индексируемый корпус roblox/knowledge. Сам корпус - в git.
roblox/data/

# --- сгенерированные ассеты -------------------------------------------
# Куда generate.py складывает кадры (out в плане) - это результат прогона,
# а не исходники. Сами планы лежат в projects/ и тоже не версионируются.
games/

# --- пользовательские проекты и логи -----------------------------------
# `projects/*` а не `projects/`: каталог, целиком закрытый правилом, git внутрь не
# заходит вообще, и `!`-исключения ниже не срабатывают. Дальше на каждую папку движка
# нужны ДВЕ строки: `!projects/<e>/` пускает git внутрь каталога, `projects/<e>/*`
# снова закрывает содержимое, и только `!.../engine.json` открывает сам маркер.
# Одной `!projects/<e>/` мало - она открывает и все проекты внутри.
# Так версионируется только скелет; содержимое проектов остаётся у каждого своё.
# Пустой projects/<e>/engine.json - инициализатор движка: без него проект в этой
# папке не получает ни профиль агента, ни набор MCP-серверов.
projects/*
!projects/.gitignore
!projects/README.md
!projects/three/
projects/three/*
!projects/three/engine.json
!projects/godot/
projects/godot/*
!projects/godot/engine.json
!projects/unity/
projects/unity/*
!projects/unity/engine.json
!projects/roblox/
projects/roblox/*
!projects/roblox/engine.json
logs/
godot/logs/
unity/logs/
roblox/logs/
*.log

# --- сессии агента и креды --------------------------------------------
pi-home/sessions/
pi-home-*/sessions/
pi-home*/auth.json
pi-home*/models-store.json
pi-home*/models.json

# --- личные заметки ----------------------------------------------------
.workbuddy-ai/

# --- машинные пути (абсолютные, у каждого свои) ------------------------
local.env.cmd

# --- бэкапы локальных правок и вывод прогонов ---------------------------
data/backup/
output/
m2m/
# Обратимая локальная уборка: устаревшие лаунчеры и тестовые проекты
# переносятся сюда, но НЕ должны уезжать в общий репозиторий - в нём нет
# ни существующих проектов, ни чужих машинных артефактов.
archive/

# --- состояние сессии (у каждого своё) --------------------------------
data/active_project.txt
# Кэш reliability-слоя: сводка шагов по прогонам. Воспроизводится из логов.
data/reliability/
